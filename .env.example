# Firebase Public configuration (Client-side)
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="1:your-sender-id:web:app-hash"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-MEASUREMENTID"

# Firebase Admin configuration (Server-side)
FIREBASE_ADMIN_PROJECT_ID="your-project-id"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-abcde@your-project-id.iam.gserviceaccount.com"
# Important: ensure your private key is enclosed in quotes and formatting includes \n for newlines
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_BASE64_ENCODED_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# API Providers
APIMART_API_KEY="your_apimart_api_key_here"

# Public bot / app URLs
NEXT_PUBLIC_TELEGRAM_BOT_URL="https://t.me/StudioXCbot"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="StudioXCbot"
NEXT_PUBLIC_SITE_URL="https://studiox.app"
